aeos:schema = {
  id = "altopelago.schema-policy-showcase.closed.v1"
  version = "1"
  world = "closed"

  rules = {
    "$.app" = {
      required = true
      type = "ObjectNode"
      datatype = "config"
    }

    "$.app.name" = {
      required = true
      type = "StringLiteral"
      min_length = 1
    }

    "$.app.port" = {
      required = true
      type = "IntegerLiteral"
      sign = "unsigned"
      min_value = "1"
      max_value = "65535"
    }

    "$.app.region" = {
      required = true
      reference = "allow"
      reference_target_path = "$.regions[*]"
      type = "StringLiteral"
      min_length = 3
      resolve_reference_form = true
    }

    "$.regions" = {
      required = true
      type = "ListNode"
      datatype = "stringList"
    }

    "$.regions[*]" = {
      required = true
      type = "StringLiteral"
      min_length = 3
    }
  }
}
