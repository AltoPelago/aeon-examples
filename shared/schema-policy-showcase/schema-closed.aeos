aeos:schema = {
  id = "altopelago.schema-policy-showcase.closed.v1"
  version = "1"
  world = "closed"

  rules:list<object> = [
    {
      path:sansa = $.app
      constraints:object = {
        required:boolean = true
        type:string = "ObjectNode"
        datatype:string = "config"
      }
    }
    {
      path:sansa = $.app.name
      constraints:object = {
        required:boolean = true
        type:string = "StringLiteral"
        min_length:int = 1
      }
    }
    {
      path:sansa = $.app.port
      constraints:object = {
        required:boolean = true
        type:string = "IntegerLiteral"
        sign:string = "unsigned"
        min_value:string = "1"
        max_value:string = "65535"
      }
    }
    {
      path:sansa = $.app.region
      constraints:object = {
        required:boolean = true
        reference:string = "allow"
        reference_target_pattern:string = "^\\$\\.regions\\[\\d+\\]$"
        type:string = "StringLiteral"
        min_length:int = 3
        resolve_reference_form:boolean = true
      }
    }
    {
      path:sansa = $.regions
      constraints:object = {
        required:boolean = true
        type:string = "ListNode"
        datatype:string = "stringList"
      }
    }
    {
      selector:sansa = $.regions.*
      constraints:object = {
        required:boolean = true
        type:string = "StringLiteral"
        min_length:int = 3
      }
    }
  ]
}
