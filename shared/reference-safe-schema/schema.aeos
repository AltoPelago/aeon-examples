aeos:schema = {
  id = "altopelago.reference-safe-schema.v1"
  version = "1"

  rules = {
    "$.person.postcode" = {
      required = true
      reference = "allow"
      reference_target_pattern = "^\\$\\.postcodes\\[\\d+\\]$"
      type = "IntegerLiteral"
      min_value = "1000"
      max_value = "9999"
      resolve_reference_form = true
    }

    "$.person.age" = {
      required = true
      reference = "allow"
      reference_target_pattern = "^\\$\\.ages\\[\\d+\\]$"
      type = "IntegerLiteral"
      min_value = "0"
      max_value = "120"
      resolve_reference_form = true
    }
  }
}
