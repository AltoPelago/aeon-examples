{
  "schema_id": "altopelago.reference-safe-schema.v1",
  "schema_version": "1",
  "rules": [
    {
      "path": "$.person.postcode",
      "constraints": {
        "required": true,
        "reference": "require",
        "reference_kind": "clone",
        "reference_target_pattern": "^\\$\\.postcodes\\[\\d+\\]$",
        "type": "IntegerLiteral",
        "min_value": "1000",
        "max_value": "9999",
        "resolve_reference_form": true
      }
    },
    {
      "path": "$.person.age",
      "constraints": {
        "required": true,
        "reference": "require",
        "reference_kind": "clone",
        "reference_target_pattern": "^\\$\\.ages\\[\\d+\\]$",
        "type": "IntegerLiteral",
        "min_value": "0",
        "max_value": "120",
        "resolve_reference_form": true
      }
    }
  ]
}
