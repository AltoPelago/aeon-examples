aeos:schema = {
  id = "altopelago.contact-list.schema.v1"
  version = "1"

  rules:list<object> = [
    {
      path:sansa = $.contacts
      constraints:object = {
        required:boolean = true
        type:string = "ListNode"
        datatype:string = "contactList"
      }
    }
    {
      selector:sansa = $.contacts.*.firstName
      constraints:object = {
        required:boolean = true
        type:string = "StringLiteral"
        min_length:int = 1
      }
    }
    {
      selector:sansa = $.contacts.*.lastName
      constraints:object = {
        required:boolean = true
        type:string = "StringLiteral"
        min_length:int = 1
      }
    }
    {
      selector:sansa = $.contacts.*.email
      constraints:object = {
        required:boolean = true
        type:string = "StringLiteral"
        min_length:int = 3
      }
    }
    {
      selector:sansa = $.contacts.*.phone
      constraints:object = {
        required:boolean = true
        type:string = "StringLiteral"
        min_length:int = 8
      }
    }
    {
      selector:sansa = $.contacts.*.countryCode
      constraints:object = {
        required:boolean = true
        type:string = "StringLiteral"
        min_length:int = 2
        max_length:int = 2
      }
    }
  ]
}
