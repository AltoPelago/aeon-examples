{
  "schema_id": "altopelago.contact-list.schema.v1",
  "schema_version": "1",
  "rules": [
    {
      "path": "$.contacts",
      "constraints": {
        "required": true,
        "type": "ListNode",
        "datatype": "contactList"
      }
    },
    {
      "selector": "$.contacts.*.firstName",
      "constraints": {
        "required": true,
        "type": "StringLiteral",
        "min_length": 1
      }
    },
    {
      "selector": "$.contacts.*.lastName",
      "constraints": {
        "required": true,
        "type": "StringLiteral",
        "min_length": 1
      }
    },
    {
      "selector": "$.contacts.*.email",
      "constraints": {
        "required": true,
        "type": "StringLiteral",
        "min_length": 3
      }
    },
    {
      "selector": "$.contacts.*.phone",
      "constraints": {
        "required": true,
        "type": "StringLiteral",
        "min_length": 8
      }
    },
    {
      "selector": "$.contacts.*.countryCode",
      "constraints": {
        "required": true,
        "type": "StringLiteral",
        "min_length": 2,
        "max_length": 2
      }
    }
  ]
}
